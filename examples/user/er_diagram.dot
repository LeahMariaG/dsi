digraph workflow_schema { node [shape=plaintext]; dpi=300 rankdir=LR splines=true overlap=false math [label=<<TABLE CELLSPACING="0"><TR><TD COLSPAN="1"><B>math</B></TD></TR><TR><TD PORT="specification">specification</TD></TR><TR><TD PORT="a">a</TD></TR><TR><TD PORT="b">b</TD></TR><TR><TD PORT="c">c</TD></TR><TR><TD PORT="d">d</TD></TR><TR><TD PORT="e">e</TD></TR><TR><TD PORT="f">f</TD></TR></TABLE>>]; address [label=<<TABLE CELLSPACING="0"><TR><TD COLSPAN="1"><B>address</B></TD></TR><TR><TD PORT="specification">specification</TD></TR><TR><TD PORT="fileLoc">fileLoc</TD></TR><TR><TD PORT="g">g</TD></TR><TR><TD PORT="h">h</TD></TR><TR><TD PORT="i">i</TD></TR><TR><TD PORT="j">j</TD></TR><TR><TD PORT="k">k</TD></TR><TR><TD PORT="l">l</TD></TR><TR><TD PORT="m">m</TD></TR></TABLE>>]; physics [label=<<TABLE CELLSPACING="0"><TR><TD COLSPAN="1"><B>physics</B></TD></TR><TR><TD PORT="specification">specification</TD></TR><TR><TD PORT="n">n</TD></TR><TR><TD PORT="o">o</TD></TR><TR><TD PORT="p">p</TD></TR><TR><TD PORT="q">q</TD></TR><TR><TD PORT="r">r</TD></TR><TR><TD PORT="s">s</TD></TR></TABLE>>]; dsi_units [label=<<TABLE CELLSPACING="0"><TR><TD COLSPAN="1"><B>dsi_units</B></TD></TR><TR><TD PORT="table_name">table_name</TD></TR><TR><TD PORT="column_and_unit">column_and_unit</TD></TR></TABLE>>]; }